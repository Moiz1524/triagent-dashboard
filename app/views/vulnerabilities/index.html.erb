<% content_for :title, "Findings · Triagent" %>
<div class="flex items-end justify-between"><div><p class="text-sm font-bold tracking-[0.18em] text-brand">SECURITY OPERATIONS</p><h1 class="mt-1 text-3xl font-bold text-ink">Vulnerability findings</h1><p class="mt-2 text-slate-500">A single place for triage, review, and remediation context.</p></div></div>
<section class="mt-8 grid gap-4 lg:grid-cols-3" data-controller="findings-chart" data-findings-chart-severity-value="<%= @severity_stats.to_json %>" data-findings-chart-total-value="<%= @total_findings %>"><%= link_to root_path, class: "card p-5 transition hover:-translate-y-0.5 hover:border-indigo-200" do %><p class="text-sm font-medium text-slate-500">All findings</p><p class="mt-2 text-4xl font-bold text-ink"><%= @total_findings %></p><p class="mt-3 text-xs font-semibold text-brand">View all findings →</p><% end %><div class="card p-5 lg:col-span-2"><div class="flex items-start justify-between"><div><p class="text-sm font-medium text-slate-500">Severity distribution</p><p class="mt-1 text-xs text-slate-400">Select a bar to filter the findings list.</p></div><span data-findings-chart-target="selection" class="pill bg-indigo-50 text-indigo-700">All severities</span></div><div data-findings-chart-target="severity" class="mt-5 grid gap-3 sm:grid-cols-5" aria-label="Severity chart"></div></div></section>
<section class="mt-4 card p-5" data-controller="dependency-chart" data-dependency-chart-items-value="<%= @dependency_stats.to_h.to_json %>"><div class="flex items-start justify-between"><div><p class="text-sm font-medium text-slate-500">Dependencies mentioned in findings</p><p class="mt-1 text-xs text-slate-400">Select a dependency to search the current finding set.</p></div><span class="pill bg-indigo-50 text-indigo-700" data-dependency-chart-target="count"></span></div><div data-dependency-chart-target="list" class="mt-5 space-y-3" aria-label="Dependency distribution"></div></section>
<%= form_with url: root_path, method: :get, class: "mt-8 grid gap-3 rounded-xl bg-white p-4 shadow-sm md:grid-cols-4" do |f| %><%= f.search_field :query, value: params[:query], placeholder: "Search title, ID, or location", class: "rounded-lg border-slate-300 md:col-span-1" %><%= f.select :severity, Vulnerability.severities.keys.map { |v| [v.humanize, v] }, { include_blank: "All severities", selected: params[:severity] }, class: "rounded-lg border-slate-300" %><%= f.select :status, Vulnerability.statuses.keys.map { |v| [v.humanize, v] }, { include_blank: "All statuses", selected: params[:status] }, class: "rounded-lg border-slate-300" %><div class="flex gap-2"><%= f.select :assessment_category, Vulnerability.assessment_categories.keys.map { |v| [v.humanize, v] }, { include_blank: "All assessments", selected: params[:assessment_category] }, class: "w-full rounded-lg border-slate-300" %><%= f.submit "Filter", class: "rounded-lg bg-brand px-4 font-semibold text-white" %></div><% end %>
<section class="mt-5 overflow-x-auto card"><table class="min-w-[1300px] w-full text-left text-sm"><thead class="bg-slate-50 text-xs uppercase tracking-wide text-slate-500"><tr><th class="px-5 py-3">Finding & location</th><th class="px-5 py-3">Assessment</th><th class="px-5 py-3">Severity</th><th class="px-5 py-3">Status</th><th class="px-5 py-3">Dependencies</th><th class="px-5 py-3">Reviewers</th><th class="px-5 py-3">Remediation</th><th class="px-5 py-3">Seen</th><th class="px-5 py-3">Assessment PDF</th></tr></thead><tbody class="divide-y divide-slate-100"><% @vulnerabilities.each do |v| %><tr class="align-top hover:bg-slate-50"><td class="px-5 py-4"><%= link_to v.summary.presence || v.humanized_slug_id, vulnerability_path(v), class: "font-semibold text-ink hover:text-brand" %><p class="mt-1 text-xs text-slate-500"><%= v.humanized_slug_id %></p><p class="mt-1 max-w-xs truncate text-xs text-slate-500"><%= v.possible_location.presence || "No location supplied" %></p></td><td class="px-5 py-4 text-slate-600"><%= v.assessment_category&.humanize || "Pending" %></td><td class="px-5 py-4"><span class="pill bg-slate-100"><%= v.severity&.humanize || "Unrated" %></span></td><td class="px-5 py-4"><%= v.status.humanize %></td><td class="px-5 py-4 text-slate-600"><%= v.external_libs_details.filter_map { |lib| lib['name'] || lib[:name] }.to_sentence.presence || "—" %></td><td class="px-5 py-4 text-slate-600"><%= v.assigned_reviewers.map(&:full_name).to_sentence.presence || "—" %></td><td class="px-5 py-4"><%= link_to "Open", v.remediation_link, class: "text-brand", target: "_blank", rel: "noopener" if v.remediation_link.present? %></td><td class="px-5 py-4 text-slate-500"><%= v.seen_at&.to_date || "—" %></td><td class="px-5 py-4 text-slate-500"><%= v.full_assessment.attached? ? "Attached" : "—" %></td></tr><% end %><% if @vulnerabilities.empty? %><tr><td colspan="9" class="px-5 py-10 text-center text-slate-500">No findings match these filters.</td></tr><% end %></tbody></table></section>
