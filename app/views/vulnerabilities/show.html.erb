<% content_for :title, "#{@vulnerability.humanized_slug_id} · Triagent" %>
<%= link_to "← All findings", root_path, class: "text-sm font-semibold text-brand" %>
<div class="mt-5 flex flex-wrap items-start justify-between gap-4"><div><p class="text-sm font-bold tracking-[0.15em] text-brand"><%= @vulnerability.humanized_slug_id %></p><h1 class="mt-1 text-3xl font-bold text-ink"><%= @vulnerability.summary.presence || "Untitled finding" %></h1><p class="mt-2 text-slate-500"><%= @vulnerability.possible_location.presence || "No possible location recorded" %></p></div><div class="flex gap-2"><span class="pill bg-red-50 text-red-700"><%= @vulnerability.severity&.humanize || "Unrated" %></span><span class="pill bg-slate-100"><%= @vulnerability.status.humanize %></span></div></div>

<section class="mt-8 card p-6"><h2 class="text-lg font-bold text-ink">Record details</h2><dl class="mt-5 grid gap-x-8 gap-y-5 text-sm md:grid-cols-2 xl:grid-cols-3"><div><dt class="text-slate-500">Database ID</dt><dd class="mt-1 font-medium"><%= @vulnerability.id %></dd></div><div><dt class="text-slate-500">Finding ID</dt><dd class="mt-1 font-medium"><%= @vulnerability.humanized_slug_id %></dd></div><div><dt class="text-slate-500">Company</dt><dd class="mt-1 font-medium"><%= @vulnerability.company.name %></dd></div><div><dt class="text-slate-500">Assessment category</dt><dd class="mt-1 font-medium"><%= @vulnerability.assessment_category&.humanize || "Pending" %></dd></div><div><dt class="text-slate-500">Severity</dt><dd class="mt-1 font-medium"><%= @vulnerability.severity&.humanize || "Unrated" %></dd></div><div><dt class="text-slate-500">Workflow status</dt><dd class="mt-1 font-medium"><%= @vulnerability.status.humanize %></dd></div><div><dt class="text-slate-500">Seen at</dt><dd class="mt-1 font-medium"><%= @vulnerability.seen_at&.to_fs(:long) || "—" %></dd></div><div><dt class="text-slate-500">Created at</dt><dd class="mt-1 font-medium"><%= @vulnerability.created_at.to_fs(:long) %></dd></div><div><dt class="text-slate-500">Last updated</dt><dd class="mt-1 font-medium"><%= @vulnerability.updated_at.to_fs(:long) %></dd></div><div><dt class="text-slate-500">Archived</dt><dd class="mt-1 font-medium"><%= @vulnerability.archived? ? "Yes" : "No" %></dd></div><div><dt class="text-slate-500">GitHub issue</dt><dd class="mt-1"><%= link_to @vulnerability.github_issue_url, @vulnerability.github_issue_url, class: "break-all text-brand", target: "_blank", rel: "noopener" if @vulnerability.github_issue_url.present? %><%= "—" unless @vulnerability.github_issue_url.present? %></dd></div><div><dt class="text-slate-500">Remediation link</dt><dd class="mt-1"><%= link_to @vulnerability.remediation_link, @vulnerability.remediation_link, class: "break-all text-brand", target: "_blank", rel: "noopener" if @vulnerability.remediation_link.present? %><%= "—" unless @vulnerability.remediation_link.present? %></dd></div></dl></section>

<div class="mt-6 grid gap-6 lg:grid-cols-3"><aside class="card p-6 lg:col-span-1"><h2 class="text-lg font-bold text-ink">Assigned reviewers</h2><% if @vulnerability.assigned_reviewers.any? %><ul class="mt-4 space-y-3"><% @vulnerability.assigned_reviewers.each do |reviewer| %><li><p class="font-semibold"><%= reviewer.full_name %></p><p class="text-sm text-slate-500"><%= reviewer.email %></p></li><% end %></ul><% else %><p class="mt-3 text-sm text-slate-400">No reviewers assigned.</p><% end %><h2 class="mt-8 text-lg font-bold text-ink">External libraries</h2><% if @vulnerability.external_libs_details.any? %><ul class="mt-4 space-y-3"><% @vulnerability.external_libs_details.each do |library| %><li><p class="font-semibold"><%= library['name'] || library[:name] %></p><%= link_to library['repo_link'] || library[:repo_link], library['repo_link'] || library[:repo_link], class: "break-all text-sm text-brand", target: "_blank", rel: "noopener" if (library['repo_link'] || library[:repo_link]).present? %></li><% end %></ul><% else %><p class="mt-3 text-sm text-slate-400">No dependency information captured.</p><% end %></aside>
<div class="space-y-6 lg:col-span-2"><section class="card p-6"><h2 class="text-lg font-bold text-ink">Initial report</h2><div class="mt-4 whitespace-pre-wrap leading-7 text-slate-700"><%= @vulnerability.initial_report.presence || "No initial report has been captured." %></div></section><section class="card p-6"><h2 class="text-lg font-bold text-ink">Full assessment</h2><p class="mt-2 text-sm text-slate-500">This agent-generated PDF should include context, affected-file tree analysis, proposed fixes, and preventive measures.</p><% if @vulnerability.full_assessment.attached? %><dl class="mt-4 grid gap-3 text-sm sm:grid-cols-2"><div><dt class="text-slate-500">File name</dt><dd class="font-medium"><%= @vulnerability.full_assessment.filename %></dd></div><div><dt class="text-slate-500">File size</dt><dd class="font-medium"><%= number_to_human_size(@vulnerability.full_assessment.byte_size) %></dd></div><div><dt class="text-slate-500">Content type</dt><dd class="font-medium"><%= @vulnerability.full_assessment.content_type %></dd></div><div><dt class="text-slate-500">Uploaded</dt><dd class="font-medium"><%= @vulnerability.full_assessment.created_at.to_fs(:long) %></dd></div></dl><%= link_to "Open assessment PDF", @vulnerability.full_assessment, target: "_blank", class: "mt-5 inline-block rounded-lg bg-brand px-4 py-2 font-semibold text-white" %><% else %><p class="mt-4 text-sm text-slate-400">Awaiting the agent-generated assessment PDF.</p><% end %></section></div></div>
