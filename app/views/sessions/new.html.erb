<div class="mx-auto mt-24 max-w-md"><div class="card p-8"><p class="text-sm font-bold tracking-[0.2em] text-brand">TRIAGENT</p><h1 class="mt-3 text-3xl font-bold text-ink">Sign in</h1><p class="mt-2 text-slate-500">Access your security findings workspace.</p><%= form_with url: login_path, class: "mt-7 space-y-5" do |f| %><div><%= f.label :email, class: "text-sm font-semibold" %><%= f.email_field :email, required: true, autofocus: true, class: "mt-1 w-full rounded-lg border-slate-300" %></div><div><%= f.label :password, class: "text-sm font-semibold" %><%= f.password_field :password, required: true, class: "mt-1 w-full rounded-lg border-slate-300" %></div><%= f.submit "Sign in", class: "w-full rounded-lg bg-brand py-2.5 font-semibold text-white" %><% end %></div></div>
